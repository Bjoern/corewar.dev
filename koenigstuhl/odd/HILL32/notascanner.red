;redcode-94b
;assert 1
;name NotAScanner
;author Roman Muentener
;strategy kill_the_opponent
;date 2014-May-20
;version 1

SDIST	EQU 	37
BDIST	EQU	35

	JMP	SCAN
SPTR2	DAT	#SDIST,#SDIST
SCAN	SEQ.B	@SPTR, @BPTR
	JMP	BOMB
CONT	ADD.AB	#SDIST, SPTR
	SUB.AB	#BDIST, BPTR
	SEQ.B	@SPTR, @BPTR
	JMP	BOMB
	ADD.AB	#SDIST, SPTR
	SUB.AB	#BDIST, BPTR
	DJN.A	SCAN, SPTR
SPLB	SPL	0, 0
CLEAR	MOV	QBMP, >SPTR2
	MOV	QBMP, >SPTR2
	MOV	QBMP, >SPTR2
	JMP	CLEAR
BOMB	MOV	SPLB, @SPTR
	MOV	SPLB, @BPTR
	JMP	CONT
SPTR	DAT 	#((CORESIZE/SDIST)-20),#(5*SDIST)
BPTR	DAT	#((CORESIZE/SDIST)-20),#(-5*SDIST)
QBMP	DAT	#0, #25