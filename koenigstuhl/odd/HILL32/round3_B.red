;redcode
;assert 1;
;name rdrc: Gymnosperm Trick
;author Dave Hillis
;strat -   Gymnosperm Trickery hand modified
;strat -   Created using RedRace.c.
;strat -   An evolving population playing KOTH.
;strat -   Configured for the 88 standard hill.
;strat -   Made it as high as 8th on 88 Standard hill.
;strat -   Much higher than any other warrior I've ever evolved.
   spl     #     0, <    -2
   spl     #     0, <    -3
   mov    $     1, <     1
   mov    <     0, <  -6    ; changed from 3432 for contest
   djn     $    -2, <    -7
   end   0
