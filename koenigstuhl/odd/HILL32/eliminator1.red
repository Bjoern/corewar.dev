;redcode-94
;name Eliminator - Special Edition I
;author Zul Nadzri
;strategy Developed ONLY for Round 9 Tournament!
;strategy Target: Maximum wins, minimum defeat
;assert 1

start	spl 1
	spl 1
	mov -1, 	0
	spl 1
     	spl 1,  	}1
     	mul #1, 	1

silk 	spl @0,	>1
     	mov }silk,	>silk
     	mov <-1,	<-1
	jmp -1,	<-1

     end start

