;redcode-94
;name I Love OneShot
;author Zul Nadzri
;assert 1
;strategy  for tiny hill dat 1,1 Round 10 TriNity
;strategy  What else can I do with 5 instructions? How about 2?
;strategy  Try to rob points from scanners
;strategy  I think I can win the shortest instruction, non-last ranked warrior 

start	spl #1,#1
	mov -1,>1

end start