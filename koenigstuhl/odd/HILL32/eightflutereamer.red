;redcode-94nop
;name Eight flute REAMer
;author Steve Gunnell
;strategy Simple paper generated by my REAMer core.
;strategy Easter 2016
;assert 1

        ORG        start

MARK   equ 1419
STEP1  equ 3749
STEP2  equ 1782

HOP    equ 1529

start:
       spl  1, <MARK ;
       spl  1,}MARK ;
       spl  1,>MARK ; 8 ; 12
       spl    @0    ,{STEP1
       mov.i  }-1   ,>-1
       mov.i  }-2 , >-2 ; 8
loop1:
       spl    @0    ,{STEP2
       mov.i  }-1   ,>-1 ; 2
       mov.i bomb1,{MARK ; 4
       add.ab #HOP,loop1
       jmp   loop1,{loop1 ; 42
bomb1:
       mov.i  #1, {1 ; 3


        END
