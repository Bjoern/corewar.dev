;redcode-94
;name Eliminator - Special Edition II
;author Zul Nadzri
;strategy Developed ONLY for Round 9 Tournament!
;strategy Target: Maximum wins, minimum defeats
;assert 1

start	spl 1
	spl 1
	spl 1
	spl 1
     	spl 1,	}1
     	mul #1,   	1

 	spl @0,    	>1
     	mov }-1, 	>-1
     	mov <-1,   	<-1
	jmp -1, 	<-1

for MAXLENGTH-10
dat {-1, <-1
rof
     end start

