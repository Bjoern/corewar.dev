;redcode-94
;name 2365*2^2936+1 is prime!
;author John Metcalf
;strategy paper for IRC Mini Tournament #03
;strategy and, the optima prime is 888 digits long!
;assert 1

     spl   1
     spl   1,     }1
     mul   #1,    1

pap1 spl   @0,    >1
     mov   }pap1, >pap1
     mov   <-1,   <-1
     mov.i #1,    1
     end

