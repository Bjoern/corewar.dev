;redcode-94
;name Semi-Skilled Redcoder
;author John Metcalf
;strategy one-shot for IRC Mini Tournament #03
;assert 1

     add.f #1,     }1
     mul.a #1,     1
ptr  add   #1,     #1
     jmz.f ptr,    @ptr 
     mov   @-1,    #1
     mov   @1,     >-1
     jmp   -1,     >1
     dat   1,      1

; no time to include a decoy :-/

     end
