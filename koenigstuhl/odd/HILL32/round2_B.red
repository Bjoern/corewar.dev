;redcode
;assert 1
;name Canopy Mite
;author Dave Hillis
;strat -   Created using RedRace.c.
;strat -   An evolving population playing KOTH.
ORG START
       dat.ab   {   -35, >     2
       dat.i    }   -74, #     7
START  spl.ba   #    -8, >    25
       mov.i    {    -2, {    -1
       mov.i    {    -2, {    -3
       djn.i    $    -2, {    -4
