;redcode
;assert 1
;name Daylight Asparagus
;author Dave Hillis
;strat -   Created using RedRace.c.
;strat -   An evolving population playing KOTH.
ORG START
       dat.ab   @   -45, $     8
       spl.b    #     0, {     0
       mov.i    {     1, {    -3
START  mov.i    <    52, {    -3
       djn.i    $    -2, {    -4
       djn.x    $    -3, $    -4
