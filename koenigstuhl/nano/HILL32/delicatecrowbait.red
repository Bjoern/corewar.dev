;redcode-nano
;assert CORESIZE == 80
;name rdrc: Delicate Crowbait
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
mov.i  >   -37, $    32
spl.i  #   -28, >    24
mov.i  }    -6, {     0
mov.i  <   -24, {    -2
djn.i  $    -2, $    -3
end   0
