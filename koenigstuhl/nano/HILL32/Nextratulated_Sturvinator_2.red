;assert CORESIZE == 80

org 0

C1  equ  59

x0  mov    < 70  ,    29
    spl    # 25  ,  < x0 + C1
    mov    < 65  ,  { 79
    mov    } -1  ,  < x0 + C1
    djn.f    -2  ,  < x0 + C1
