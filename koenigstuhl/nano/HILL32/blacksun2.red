;strategy Watch the Sun!
;assert CORESIZE == 80
        
        ORG start   

start   spl.x   # 0, < 67
        mov.i   } 79, > 79  
        mov.i   > 29, < 50  
        mov.i   > 18, $ 39  
        djn.i   @ 64, < 1

        END
