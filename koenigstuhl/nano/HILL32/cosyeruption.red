;redcode-nano
;assert CORESIZE == 80
;name rdrc: Cosy Eruption
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
spl.b  #   -36, >    15
mov.i  *   -14, {     0
mov.i  >   -32, {    -2
djn.f  $    -2, $    -3
mov.i  @    -4, {   -38
end   0

