;redcode-nano
;assert CORESIZE == 80
;name rdrc: Revere Gimmickry
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
spl.i  #    39, >    15
mov.i  }   -20, {     0
mov.i  >   -18, {    -2
djn.f  $    -2, $    -3
mov.i  $    -4, <    24
end   0
