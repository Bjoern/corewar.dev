;redcode-nano
;assert CORESIZE == 80
;name rdrc: Hexadecimal Bunny
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
spl.i  #   -38, >    18
mov.i  }    -9, {     0
mov.i  >   -31, {    -2
djn.i  $    -2, $    -3
mov.i  #     6, <   -15
end   0

