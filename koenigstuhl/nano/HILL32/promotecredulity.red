;redcode-nano
;assert CORESIZE == 80
;name rdrc: Promote Credulity
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
spl.b  #    -6, >   -35
spl.b  #   -33, <   -39
mov.i  }   -17, {     0
mov.i  #   -12, }     1
djn.i  $    18, <    -3
end   0

