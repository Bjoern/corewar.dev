;name Black Sun
;author Fluffy
;strategy Watch the Sun!
;assert CORESIZE == 80
        
        ORG start   

start   spl.x   # 0, < 28
        mov.i   } 79, > 79  
        mov.i   > 36, { 15  
        mov.i   > 44, { 73  
        djn.i   @ 25, $ 72

        END
