;redcode-nano
;assert CORESIZE == 80
;name rdrc: Sanctimonious Burden
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
mov.i  <    32, $    13
spl.i  #   -27, >    24
mov.i  *    -6, {     0
mov.i  <   -23, {    -2
djn.i  $    -2, $    -3
end   0
