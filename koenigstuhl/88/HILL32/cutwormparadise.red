;redcode-88
;assert CORESIZE == 8000
;name rdrc: Cutworm Paradise 
;author Dave Hillis
;strategy -   Created using RedRace.c.
;strategy -   An evolving population playing KOTH.
;strat -   Configured for the 88 standard hill.
spl  $     0, <  3419
spl  <    -1, <    12
mov  <    12, <  3417
mov  <  1498, <  1937
mov  <   119, <  -191
jmp  $    -3, $     7
end   0

