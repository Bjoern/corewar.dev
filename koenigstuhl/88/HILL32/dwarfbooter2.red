;redcode-94
;name dwarf booter 2.0
;author Rimbecano
;strategy Dwarf with tweaked stepsize, boot, and new bomb.
;assert CORESIZE==8000


        jmp 100, 0 ;100
dwarf   add #1364, -1
        mov -2, @-2
        jmp dwarf

boot    mov -4, 3996
        mov -4, 3996
        mov -4, 3996
        mov -4, 3996
        jmp 3993


for 91
        dat #99, #99
rof

end boot

